# Rollback is the whole reason for the two-slot layout: without it a bad image
# that cannot reach NervesHub is unrecoverable without physical access.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# NOTE: the partition table is deliberately NOT set here. This is a library
# crate, and esp-idf-sys builds ESP-IDF in its own output directory where a
# relative `partitions.csv` does not exist. Your *application* sets:
#
#   CONFIG_PARTITION_TABLE_CUSTOM=y
#   CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
#
# and provides the file. `partitions.csv` here is a working example to copy.

# The websocket client and TLS.
CONFIG_ESP_TLS_USING_MBEDTLS=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# esp-idf-svc needs a larger main task stack than the default once TLS is in
# the picture.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10000

# Your *application* must set the version NervesHub records. It is read from
# esp_app_desc_t.version, both at upload and from the running image, and must
# parse as SemVer. Left unset, ESP-IDF fills it from `git describe`, which does
# not — and a device reporting an unparseable version has no firmware metadata
# server-side, so it can never be matched to a deployment while looking
# perfectly healthy.
#
#   CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
#   CONFIG_APP_PROJECT_VER="1.0.0"
#
# Not set here: the version belongs to the application, not to this library.
#
# The project name has no equivalent setting — esp-idf-sys hardcodes the CMake
# project name to `libespidf`, and NervesHub matches that field against the
# product. See scripts/set_app_desc.py.
